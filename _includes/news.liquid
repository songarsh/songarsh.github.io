{% comment %}
  News section: same look as the al-folio default (date column + content
  column, scrollable when long).

  When called with `limit=true` (the about page), only items from the last 2
  years are shown -- recent activity, no clutter. Without `limit` (the
  full /news/ archive page), every entry in _news/ is rendered.

  Bump `recent_seconds` below to widen / narrow the about-page window.
{% endcomment %}
<div class="news">
  {% if site.news != blank %}
    {% comment %}2 years = 2 * 365 * 86400 seconds = 63072000{% endcomment %}
    {% assign recent_seconds = 63072000 %}
    {% assign now_ts = "now" | date: "%s" %}
    {% assign cutoff_ts = now_ts | minus: recent_seconds %}

    {% comment %}When include.limit is on we filter to the recent window.{% endcomment %}
    {% assign filter_recent = include.limit %}

    {% comment %}Count visible items so we know whether to enable scroll.{% endcomment %}
    {% assign visible_size = 0 %}
    {% for item in site.news %}
      {% if filter_recent %}
        {% assign item_ts = item.date | date: "%s" | plus: 0 %}
        {% if item_ts >= cutoff_ts %}
          {% assign visible_size = visible_size | plus: 1 %}
        {% endif %}
      {% else %}
        {% assign visible_size = visible_size | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if visible_size > 0 %}
      {%- comment -%}
        We deliberately drop the Bootstrap `table-responsive` wrapper to
        avoid horizontal scrolling on narrow screens. The wrapper still
        controls vertical scroll for long lists when `scrollable` is set.
      {%- endcomment -%}
      <div
        class="news-scroll"
        {% if include.limit and page.announcements.scrollable and visible_size > 3 %}
          style="max-height: 60vw; overflow-y: auto;"
        {% endif %}
      >
        <table class="table table-sm table-borderless">
          {% assign news_reversed = site.news | reverse %}
          {% if include.limit and page.announcements.limit %}
            {% assign news_limit = page.announcements.limit %}
          {% else %}
            {% assign news_limit = visible_size %}
          {% endif %}
          {% assign rendered = 0 %}
          {% for item in news_reversed %}
            {% if rendered >= news_limit %}{% break %}{% endif %}
            {% assign show_item = true %}
            {% if filter_recent %}
              {% assign item_ts = item.date | date: "%s" | plus: 0 %}
              {% if item_ts < cutoff_ts %}
                {% assign show_item = false %}
              {% endif %}
            {% endif %}
            {% if show_item %}
              <tr>
                <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
                <td>
                  {% if item.inline %}
                    {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                  {% else %}
                    <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                  {% endif %}
                </td>
              </tr>
              {% assign rendered = rendered | plus: 1 %}
            {% endif %}
          {% endfor %}
        </table>
      </div>
    {% else %}
      <p>{% if filter_recent %}No recent news...{% else %}No news so far...{% endif %}</p>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
